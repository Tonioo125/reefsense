# Copy to `.env` to configure the API layer (src/api/client.ts).

# Serve data from the in-memory mock dataset (default). Set to `false` to call
# the FastAPI backend over HTTP.
# VITE_USE_MOCK=true

# Backend origin, without trailing slash. Leave empty to use same-origin `/api`,
# which the Vite dev server proxies to http://localhost:8000 (see vite.config.ts).
# A full URL such as https://api.example.org requires CORS on the backend.
# VITE_API_BASE_URL=
