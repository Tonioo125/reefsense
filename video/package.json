{
  "name": "reefsense-demo-video",
  "private": true,
  "type": "module",
  "scripts": {
    "record": "cd capture && node record.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts ReefSenseDemo out/reefsense-demo.mp4 --codec h264 --crf 18",
    "thumbnail": "remotion still src/index.ts Thumbnail out/thumbnail.png"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.534",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/transitions": "^4.0.534",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
